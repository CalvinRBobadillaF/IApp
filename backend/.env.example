# Comma-separated frontend origins. Never use * in production.
CORS_ORIGINS=http://localhost:5173

# Server-only secrets. Do not put these in VITE_ variables or the React app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Interpreter tool providers. Missing providers appear unavailable in Tools.
# Deepgram requires at least Member permission to mint temporary browser tokens.
# English/Spanish speech:
DEEPGRAM_API_KEY=
# Haitian Creole speech:
GLADIA_API_KEY=
# English <-> Spanish translation (a DeepL API subscription, not just translator Pro):
DEEPL_API_KEY=
# Any translation involving Haitian Creole. Enable Cloud Translation API + billing.
# Use a server API key, not a browser-referrer restricted key.
GOOGLE_TRANSLATE_API_KEY=
# Optional: defaults to the Free endpoint for :fx keys, otherwise Pro.
# Only https://api-free.deepl.com/v2/translate or https://api.deepl.com/v2/translate
DEEPL_API_URL=
